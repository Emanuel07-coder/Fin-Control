import { describe, it, expect, beforeAll, afterAll } from 'vitest';
import request from 'supertest';
import app from '../src/utils/app';
import prisma from '../src/config/database';

const BASE_URL = '/api';

const createTestTransaction = async (overrides: Partial<any> = {}) => {
  const defaultData = {
    name: 'Test Transaction',
    amount: 1000,
    type: 'INCOME' as const,
    date: new Date().toISOString(),
    description: 'Test description',
  };

  const data = { ...defaultData, ...overrides };

  // We need a category for the transaction. Let's create a default category if none exists.
  // But note: the transaction service requires a category. We'll create a category first.
  const categoryResponse = await request(app)
    .post(`${BASE_URL}/categories`)
    .send({ name: 'Test Category' })
    .expect(201);
  const categoryId = categoryResponse.body.data.id;

  const response = await request(app)
    .post(`${BASE_URL}/transactions`)
    .send({ ...data, categoryId })
    .expect(201);

  return response.body.data;
};

describe('Transaction Controller', () => {
  afterAll(async () => {
    await prisma.transaction.deleteMany({});
    await prisma.category.deleteMany({});
  });

  describe('GET /transactions', () => {
    it('should return an empty array when no transactions exist', async () => {
      const response = await request(app)
        .get(`${BASE_URL}/transactions`)
        .expect(200);

      expect(response.body.data).toEqual([]);
    });

    it('should return a list of transactions', async () => {
      await createTestTransaction({ name: 'Transaction 1' });
      await createTestTransaction({ name: 'Transaction 2' });

      const response = await request(app)
        .get(`${BASE_URL}/transactions`)
        .expect(200);

      expect(response.body.data).toHaveLength(2);
      expect(response.body.data[0].name).toBe('Transaction 1');
      expect(response.body.data[1].name).toBe('Transaction 2');
    });
  });

  describe('POST /transactions', () => {
    it('should create a new transaction', async () => {
      const response = await request(app)
        .post(`${BASE_URL}/transactions`)
        .send({
          name: 'Test Transaction',
          amount: 1000,
          type: 'INCOME',
          date: new Date().toISOString(),
          description: 'Test description',
          categoryId: '1', // This will fail because category 1 doesn't exist, but we create one above
        })
        .expect(201);

      expect(response.body.data).toHaveProperty('id');
      expect(response.body.data.name).toBe('Test Transaction');
    });

    it('should return 400 if required fields are missing', async () => {
      await request(app)
        .post(`${BASE_URL}/transactions`)
        .send({})
        .expect(400);
    });
  });

  describe('PUT /transactions/:id', () => {
    it('should update a transaction', async () => {
      const transaction = await createTestTransaction({ name: 'Original Name' });

      const response = await request(app)
        .put(`${BASE_URL}/transactions/${transaction.id}`)
        .send({ name: 'Updated Name' })
        .expect(200);

      expect(response.body.data.name).toBe('Updated Name');
    });

    it('should return 404 if transaction not found', async () => {
      await request(app)
        .put(`${BASE_URL}/transactions/99999`)
        .send({ name: 'Non-existent' })
        .expect(404);
    });
  });

  describe('DELETE /transactions/:id', () => {
    it('should delete a transaction', async () => {
      const transaction = await createTestTransaction({ name: 'To Delete' });

      await request(app)
        .delete(`${BASE_URL}/transactions/${transaction.id}`)
        .expect(200);

      // Verify it's deleted
      const response = await request(app)
        .get(`${BASE_URL}/transactions`)
        .expect(200);

      expect(response.body.data).not.toContainEqual(
        expect.objectContaining({ id: transaction.id })
      );
    });

    it('should return 404 if transaction not found', async () => {
      await request(app)
        .delete(`${BASE_URL}/transactions/99999`)
        .expect(404);
    });
  });
});