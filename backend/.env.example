# =============================================================================
# Fin-Control - Variáveis de Ambiente
# Copie este arquivo para `.env` e preencha os valores reais.
# NÃO commite o arquivo `.env` com secrets de produção.
# =============================================================================

# Banco de dados (PostgreSQL)
DATABASE_URL=postgresql://postgres:senha@localhost:5432/fincontrol

# -----------------------------------------------------------------------------
# Segurança JWT (OBRIGATÓRIO)
# Gere valores fortes antes de subir em produção, por exemplo:
#   openssl rand -base64 64
# -----------------------------------------------------------------------------
# Chave usada para assinar e verificar os ACCESS TOKENs (expiração curta, 15 min).
JWT_SECRET=seu_acesso_secret_aqui_min_32_caracteres
# Chave usada para assinar e verificar os REFRESH TOKENs (expiração longa, 7 dias).
JWT_REFRESH_SECRET=seu_refresh_secret_aqui_min_32_caracteres
# Chave alternativa/override para access tokens. Quando definida, tem precedência sobre JWT_SECRET.
JWT_ACCESS_SECRET=seu_access_secret_aqui_min_32_caracteres

# Servidor
PORT=3001
APP_URL=http://localhost:3001

# Node
NODE_ENV=development
